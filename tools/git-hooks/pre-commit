#!/bin/sh
# Keep original game data out of source commits.
git diff --cached --name-only --diff-filter=ACMR |
while IFS= read -r path; do
    case "$path" in
        assets/amiga/GENERATED.txt) ;;
        assets/amiga/*)
            printf '%s\n' "Original game assets must remain local: $path" >&2
            exit 1
            ;;
    esac
done
